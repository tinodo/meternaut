{
  "limits": {
    "max_schema_version": "1.5",
    "max_bytes": 20000,
    "max_title_chars": 24,
    "max_top_actions": 6,
    "max_visible_actions": 8,
    "max_hidden_actions": 4,
    "max_options": 2
  },
  "contract": {
    "who": "The card's addressee; a decision verb (not-me) also needs the designated approver or a named delegate, checked by directory object id, never by name. An answer button is a link with a one-time token that the app made for the addressee: opening it changes nothing, the page that it shows sends the answer, and a change is made there with that person's own Azure rights, after every check of the page. A card never holds a right of its own.",
    "repeat": "A repeated tap or press changes nothing: the service answers that it is already recorded, and a button that was used shows that and leads to the page.",
    "refused": "A verb is refused when its request is expired, changed, answered or paused, and the refusal says why; \"I did not approve this\" stays open. Whom to talk to is plain text in the footer of every card, so it needs no verb.",
    "response": "One immediate response per tap, as listed under returns; the outcome follows by updating the same message.",
    "words": "Only Ask or tell and the text boxes send words: bounded, screened and quoted as untrusted data. Free text never approves."
  },
