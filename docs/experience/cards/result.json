{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "fallbackText": "Result from Meternaut (AI): ${headline} Open it on the page: ${pageUrl} Written by an AI.",
  "msteams": {
    "width": "Full"
  },
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${senderName}",
              "wrap": true,
              "id": "ai-label",
              "weight": "Bolder"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "Result",
              "wrap": true,
              "id": "kind",
              "isSubtle": true
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${headline}",
      "wrap": true,
      "id": "headline",
      "size": "Large",
      "weight": "Bolder",
      "style": "heading"
    },
    {
      "type": "Container",
      "style": "emphasis",
      "id": "value-tile",
      "items": [
        {
          "type": "TextBlock",
          "text": "${value}",
          "wrap": true,
          "id": "value",
          "size": "ExtraLarge",
          "weight": "Bolder"
        },
        {
          "type": "TextBlock",
          "text": "${valueNote}",
          "wrap": true,
          "id": "value-note",
          "isSubtle": true,
          "spacing": "None"
        },
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${priceBasis}",
                  "wrap": true,
                  "id": "price-basis",
                  "weight": "Bolder"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${savingWord}",
                  "wrap": true,
                  "id": "saving-word",
                  "weight": "Bolder"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "I predicted ${predicted}. ${comparison}",
      "wrap": true,
      "id": "predicted"
    },
    {
      "type": "TextBlock",
      "text": "${how}",
      "wrap": true,
      "id": "how",
      "isSubtle": true
    },
    {
      "type": "TextBlock",
      "text": "Does this match what you expected?",
      "wrap": true,
      "id": "ask"
    },
    {
      "type": "ActionSet",
      "actions": [
        {
          "type": "Action.Execute",
          "title": "Yes, it matches",
          "verb": "matches",
          "data": {
            "requestId": "${requestId}"
          },
          "associatedInputs": "none",
          "fallback": {
            "type": "Action.OpenUrl",
            "title": "Open on the page",
            "url": "${pageUrl}"
          }
        },
        {
          "type": "Action.ShowCard",
          "title": "No, it does not",
          "card": {
            "type": "AdaptiveCard",
            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
            "version": "1.5",
            "body": [
              {
                "type": "Input.Text",
                "id": "differs",
                "label": "What did you expect?",
                "isMultiline": true,
                "maxLength": 1000,
                "placeholder": "For example: I thought the database would be cheaper too"
              }
            ],
            "actions": [
              {
                "type": "Action.Execute",
                "title": "Send",
                "verb": "differs",
                "data": {
                  "requestId": "${requestId}"
                },
                "associatedInputs": "auto",
                "fallback": {
                  "type": "Action.OpenUrl",
                  "title": "Open on the page",
                  "url": "${pageUrl}"
                }
              }
            ]
          }
        }
      ],
      "id": "result-actions"
    },
    {
      "type": "ActionSet",
      "actions": [
        {
          "type": "Action.ShowCard",
          "title": "Ask or tell",
          "card": {
            "type": "AdaptiveCard",
            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
            "version": "1.5",
            "body": [
              {
                "type": "Input.Text",
                "id": "message",
                "label": "Ask or tell",
                "isMultiline": true,
                "maxLength": 300,
                "isRequired": true,
                "errorMessage": "Write a few words first.",
                "placeholder": "A question, or something I should know. This approves nothing."
              }
            ],
            "actions": [
              {
                "type": "Action.Execute",
                "title": "Send",
                "verb": "ask",
                "data": {
                  "requestId": "${requestId}"
                },
                "associatedInputs": "auto",
                "fallback": {
                  "type": "Action.OpenUrl",
                  "title": "Open on the page",
                  "url": "${pageUrl}"
                }
              }
            ]
          }
        }
      ],
      "id": "conversation"
    },
    {
      "type": "TextBlock",
      "text": "Written by an AI; a person approves every change. You got this because ${whyYouGetThis} Talk to a person: ${contact}.",
      "wrap": true,
      "id": "ai-footer",
      "isSubtle": true,
      "size": "Small",
      "separator": true,
      "spacing": "Medium"
    }
  ]
}
