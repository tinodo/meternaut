{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "fallbackText": "Recommendation from Meternaut (AI): ${headline} Open it on the page: ${pageUrl} Written by an AI.",
  "msteams": {
    "width": "Full"
  },
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${senderName}",
              "wrap": true,
              "id": "ai-label",
              "weight": "Bolder"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "Recommendation",
              "wrap": true,
              "id": "kind",
              "isSubtle": true
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${headline}",
      "wrap": true,
      "id": "headline",
      "size": "Large",
      "weight": "Bolder",
      "style": "heading"
    },
    {
      "type": "TextBlock",
      "text": "${scopeLine}",
      "wrap": true,
      "id": "scope",
      "isSubtle": true,
      "spacing": "None"
    },
    {
      "type": "Container",
      "style": "emphasis",
      "id": "value-tile",
      "items": [
        {
          "type": "TextBlock",
          "text": "${value}",
          "wrap": true,
          "id": "value",
          "size": "ExtraLarge",
          "weight": "Bolder"
        },
        {
          "type": "TextBlock",
          "text": "${range}",
          "wrap": true,
          "id": "range",
          "isSubtle": true,
          "spacing": "None"
        },
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${priceBasis}",
                  "wrap": true,
                  "id": "price-basis",
                  "weight": "Bolder"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${savingWord}",
                  "wrap": true,
                  "id": "saving-word",
                  "weight": "Bolder"
                }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "${waiting}",
          "wrap": true,
          "id": "waiting",
          "isSubtle": true,
          "size": "Small"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Why I think so: ${why}",
      "wrap": true,
      "id": "why"
    },
    {
      "type": "TextBlock",
      "text": "What I checked: ${checked}",
      "wrap": true,
      "id": "checked"
    },
    {
      "type": "ActionSet",
      "actions": [
        {
          "type": "Action.Execute",
          "title": "Review the plan",
          "verb": "option",
          "data": {
            "requestId": "${requestId}",
            "option": "${mainOption}"
          },
          "associatedInputs": "none",
          "fallback": {
            "type": "Action.OpenUrl",
            "title": "Open on the page",
            "url": "${pageUrl}"
          }
        },
        {
          "type": "Action.Execute",
          "title": "No, leave it as it is",
          "verb": "decline",
          "data": {
            "requestId": "${requestId}"
          },
          "associatedInputs": "none",
          "fallback": {
            "type": "Action.OpenUrl",
            "title": "Open on the page",
            "url": "${pageUrl}"
          }
        },
        {
          "type": "Action.Execute",
          "title": "Not mine",
          "verb": "not-mine",
          "data": {
            "requestId": "${requestId}"
          },
          "associatedInputs": "none",
          "fallback": {
            "type": "Action.OpenUrl",
            "title": "Open on the page",
            "url": "${pageUrl}"
          }
        }
      ],
      "id": "decisions"
    },
    {
      "type": "ActionSet",
      "actions": [
        {
          "type": "Action.ToggleVisibility",
          "title": "Details",
          "tooltip": "Show or hide other options and the full reasoning",
          "targetElements": [
            "details"
          ]
        },
        {
          "type": "Action.ShowCard",
          "title": "Ask or tell",
          "card": {
            "type": "AdaptiveCard",
            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
            "version": "1.5",
            "body": [
              {
                "type": "Input.Text",
                "id": "message",
                "label": "Ask or tell",
                "isMultiline": true,
                "maxLength": 300,
                "isRequired": true,
                "errorMessage": "Write a few words first.",
                "placeholder": "A question, or something I should know. This approves nothing."
              }
            ],
            "actions": [
              {
                "type": "Action.Execute",
                "title": "Send",
                "verb": "ask",
                "data": {
                  "requestId": "${requestId}"
                },
                "associatedInputs": "auto",
                "fallback": {
                  "type": "Action.OpenUrl",
                  "title": "Open on the page",
                  "url": "${pageUrl}"
                }
              }
            ]
          }
        }
      ],
      "id": "conversation"
    },
    {
      "type": "Container",
      "id": "details",
      "isVisible": false,
      "separator": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "Other options",
          "wrap": true,
          "weight": "Bolder"
        },
        {
          "type": "Container",
          "$data": "${options}",
          "separator": true,
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${key}. ${label}",
                      "wrap": true,
                      "weight": "Bolder"
                    },
                    {
                      "type": "TextBlock",
                      "text": "${effect}",
                      "wrap": true,
                      "isSubtle": true,
                      "spacing": "None"
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "verticalContentAlignment": "Center",
                  "items": [
                    {
                      "type": "ActionSet",
                      "actions": [
                        {
                          "type": "Action.Execute",
                          "title": "Choose ${key}",
                          "verb": "option",
                          "data": {
                            "requestId": "${$root.requestId}",
                            "option": "${key}"
                          },
                          "associatedInputs": "none",
                          "fallback": {
                            "type": "Action.OpenUrl",
                            "title": "Open on the page",
                            "url": "${$root.pageUrl}"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "What each part means for you",
          "wrap": true,
          "weight": "Bolder",
          "spacing": "Medium"
        },
        {
          "type": "TextBlock",
          "text": "Consequences: ${details.consequences}",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "What was tested: ${details.tested}",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "What would change my mind: ${details.changeMyMind}",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "Effort: ${details.effort}",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "Undo: ${details.reversibility}",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "What happens on your yes: ${details.onYes}",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "How we will both know: ${details.howWeKnow}",
          "wrap": true
        },
        {
          "type": "ActionSet",
          "actions": [
            {
              "type": "Action.Execute",
              "title": "Fewer like this",
              "verb": "fewer",
              "data": {
                "requestId": "${requestId}"
              },
              "associatedInputs": "none",
              "fallback": {
                "type": "Action.OpenUrl",
                "title": "Open on the page",
                "url": "${pageUrl}"
              }
            }
          ],
          "id": "details-actions"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Written by an AI; a person approves every change. You got this because ${whyYouGetThis} Talk to a person: ${contact}.",
      "wrap": true,
      "id": "ai-footer",
      "isSubtle": true,
      "size": "Small",
      "separator": true,
      "spacing": "Medium"
    }
  ]
}
