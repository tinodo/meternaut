{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "fallbackText": "Meternaut (AI) could not finish: ${headline} Open it on the page: ${pageUrl} Written by an AI.",
  "msteams": {
    "width": "Full"
  },
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${senderName}",
              "wrap": true,
              "id": "ai-label",
              "weight": "Bolder"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "I could not do that",
              "wrap": true,
              "id": "kind",
              "isSubtle": true
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${headline}",
      "wrap": true,
      "id": "headline",
      "size": "Large",
      "weight": "Bolder",
      "style": "heading"
    },
    {
      "type": "TextBlock",
      "text": "${whatHappened}",
      "wrap": true,
      "id": "what-happened"
    },
    {
      "type": "TextBlock",
      "text": "${whatNow}",
      "wrap": true,
      "id": "what-now"
    },
    {
      "type": "ActionSet",
      "actions": [
        {
          "type": "Action.Execute",
          "title": "Try again",
          "verb": "retry",
          "data": {
            "requestId": "${requestId}"
          },
          "associatedInputs": "none",
          "fallback": {
            "type": "Action.OpenUrl",
            "title": "Open on the page",
            "url": "${pageUrl}"
          }
        }
      ],
      "id": "error-actions"
    },
    {
      "type": "ActionSet",
      "actions": [
        {
          "type": "Action.ShowCard",
          "title": "Ask or tell",
          "card": {
            "type": "AdaptiveCard",
            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
            "version": "1.5",
            "body": [
              {
                "type": "Input.Text",
                "id": "message",
                "label": "Ask or tell",
                "isMultiline": true,
                "maxLength": 300,
                "isRequired": true,
                "errorMessage": "Write a few words first.",
                "placeholder": "A question, or something I should know. This approves nothing."
              }
            ],
            "actions": [
              {
                "type": "Action.Execute",
                "title": "Send",
                "verb": "ask",
                "data": {
                  "requestId": "${requestId}"
                },
                "associatedInputs": "auto",
                "fallback": {
                  "type": "Action.OpenUrl",
                  "title": "Open on the page",
                  "url": "${pageUrl}"
                }
              }
            ]
          }
        }
      ],
      "id": "conversation"
    },
    {
      "type": "TextBlock",
      "text": "Written by an AI; a person approves every change. You got this because ${whyYouGetThis} Talk to a person: ${contact}.",
      "wrap": true,
      "id": "ai-footer",
      "isSubtle": true,
      "size": "Small",
      "separator": true,
      "spacing": "Medium"
    }
  ]
}
