{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "fallbackText": "Your OK is needed: ${headline} Open it on the page: ${pageUrl} Written by an AI.",
  "msteams": {
    "width": "Full"
  },
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${senderName}",
              "wrap": true,
              "id": "ai-label",
              "weight": "Bolder"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "Your OK",
              "wrap": true,
              "id": "kind",
              "isSubtle": true
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${headline}",
      "wrap": true,
      "id": "headline",
      "size": "Large",
      "weight": "Bolder",
      "style": "heading"
    },
    {
      "type": "TextBlock",
      "text": "When: ${plan.when}",
      "wrap": true,
      "id": "when"
    },
    {
      "type": "Container",
      "id": "plan",
      "items": [
        {
          "type": "TextBlock",
          "text": "What changes",
          "wrap": true,
          "weight": "Bolder"
        },
        {
          "type": "Container",
          "$data": "${plan.rows}",
          "separator": true,
          "items": [
            {
              "type": "TextBlock",
              "text": "${resource}: ${setting}",
              "wrap": true,
              "weight": "Bolder"
            },
            {
              "type": "FactSet",
              "facts": [
                {
                  "title": "From",
                  "value": "${from}"
                },
                {
                  "title": "To",
                  "value": "${to}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "id": "value-tile",
      "items": [
        {
          "type": "TextBlock",
          "text": "${value}",
          "wrap": true,
          "id": "value",
          "size": "ExtraLarge",
          "weight": "Bolder"
        },
        {
          "type": "TextBlock",
          "text": "${range}",
          "wrap": true,
          "id": "range",
          "isSubtle": true,
          "spacing": "None"
        },
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${priceBasis}",
                  "wrap": true,
                  "id": "price-basis",
                  "weight": "Bolder"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${savingWord}",
                  "wrap": true,
                  "id": "saving-word",
                  "weight": "Bolder"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "What could go wrong: ${plan.couldGoWrong}",
      "wrap": true,
      "id": "could-go-wrong"
    },
    {
      "type": "TextBlock",
      "text": "Undo: ${plan.undo}",
      "wrap": true,
      "id": "undo"
    },
    {
      "type": "TextBlock",
      "text": "Plan code ${planCode}. The page shows the same code. The change is made when you press Approve, with your own Azure rights, and by nobody else.",
      "wrap": true,
      "id": "plan-code",
      "isSubtle": true
    },
    {
      "type": "ActionSet",
      "actions": [
        {
          "type": "Action.OpenUrl",
          "id": "approve",
          "title": "Approve",
          "url": "${approveUrl}",
          "style": "positive",
          "$when": "${plan.cannotUndo != true}"
        },
        {
          "type": "Action.ToggleVisibility",
          "id": "approve-asks",
          "title": "Approve",
          "tooltip": "Asks once more: this cannot be undone.",
          "style": "positive",
          "targetElements": [
            {
              "elementId": "sure",
              "isVisible": true
            }
          ],
          "$when": "${plan.cannotUndo == true}"
        },
        {
          "type": "Action.OpenUrl",
          "id": "decline",
          "title": "Decline",
          "url": "${declineUrl}"
        },
        {
          "type": "Action.OpenUrl",
          "id": "page-button",
          "title": "Open the request",
          "url": "${pageUrl}"
        }
      ],
      "id": "ok-actions"
    },
    {
      "type": "Container",
      "id": "sure",
      "isVisible": false,
      "style": "attention",
      "$when": "${plan.cannotUndo == true}",
      "items": [
        {
          "type": "TextBlock",
          "text": "This cannot be undone: ${plan.lost}",
          "wrap": true,
          "id": "sure-text",
          "weight": "Bolder"
        },
        {
          "type": "ActionSet",
          "id": "sure-actions",
          "actions": [
            {
              "type": "Action.ToggleVisibility",
              "id": "sure-back",
              "title": "No, go back",
              "tooltip": "Hides this question. Nothing is changed.",
              "style": "positive",
              "targetElements": [
                {
                  "elementId": "sure",
                  "isVisible": false
                }
              ]
            },
            {
              "type": "Action.OpenUrl",
              "id": "sure-yes",
              "title": "Yes, ${plan.verb} it",
              "url": "${sureUrl}",
              "style": "destructive"
            }
          ]
        }
      ]
    },
    {
      "type": "ActionSet",
      "actions": [
        {
          "type": "Action.ShowCard",
          "title": "Ask or tell",
          "card": {
            "type": "AdaptiveCard",
            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
            "version": "1.5",
            "body": [
              {
                "type": "Input.Text",
                "id": "message",
                "label": "Ask or tell",
                "isMultiline": true,
                "maxLength": 300,
                "isRequired": true,
                "errorMessage": "Write a few words first.",
                "placeholder": "A question, or something I should know. This approves nothing."
              }
            ],
            "actions": [
              {
                "type": "Action.Execute",
                "title": "Send",
                "verb": "ask",
                "data": {
                  "requestId": "${requestId}"
                },
                "associatedInputs": "auto",
                "fallback": {
                  "type": "Action.OpenUrl",
                  "title": "Open on the page",
                  "url": "${pageUrl}"
                }
              }
            ]
          }
        }
      ],
      "id": "conversation"
    },
    {
      "type": "TextBlock",
      "text": "Written by an AI; a person approves every change. You got this because ${whyYouGetThis} Talk to a person: ${contact}.",
      "wrap": true,
      "id": "ai-footer",
      "isSubtle": true,
      "size": "Small",
      "separator": true,
      "spacing": "Medium"
    }
  ]
}
