<policies>
    <inbound>
        <base />
        <!-- Take the requested model from the request body -->
        <include-fragment fragment-id="set-llm-requested-model" />

        <!-- This contract may call one model: the small one -->
        <set-variable name="allowedModels" value="gpt-6-luna" />

        <!-- Token limits of the contract: a rate per minute and a quota per month, with the prompt's tokens estimated
             before the call so that a request that would pass the limit is refused. Past the rate the hub answers 429;
             past the quota it answers 403, and the call does not reach the model. The counters are accounting, not an
             exact pre-authorisation: calls in flight together can overshoot a little. -->
        <llm-token-limit counter-key="@(context.Subscription.Id)"
                         tokens-per-minute="30000"
                         estimate-prompt-tokens="true"
                         token-quota="2000000"
                         token-quota-period="Monthly" />

        <!-- Development only: adds the hub's debugging headers (for example the model and backend that served the call) -->
        <set-variable name="enableResponseHeaders" value="@(true)" />
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
