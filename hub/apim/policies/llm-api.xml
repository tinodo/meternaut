<policies>
    <inbound>
        <base />
        <!-- Fails closed. The contract's policy has already read the model, refused what it does not allow and counted
             the tokens. A key that is not under the contract never ran that policy, so there is no model and no list,
             and the call stops here. -->
        <choose>
            <when condition="@{
                var requested = context.Variables.GetValueOrDefault<string>("requestedModel", string.Empty);
                var allowed = context.Variables.GetValueOrDefault<string>("allowedModels", string.Empty).Split(',').Select(m => m.Trim()).ToArray();
                return requested.Length == 0 || !allowed.Any(m => m == requested);
            }">
                <return-response>
                    <set-status code="403" reason="Forbidden" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-body>{"error":{"code":"model_not_allowed","message":"The contract of this key does not allow the requested model."}}</set-body>
                </return-response>
            </when>
        </choose>
        <!-- The model account answers only on its private endpoint; the instance reaches it through the landing zone's network. -->
        <set-backend-service base-url="${FOUNDRY_ENDPOINT}" />
        <rewrite-uri template="/openai/v1/chat/completions" copy-unmatched-params="false" />
        <set-query-parameter name="api-version" exists-action="override">
            <value>v1</value>
        </set-query-parameter>
        <!-- The caller's key stops here; the instance's own identity calls the model. -->
        <set-header name="api-key" exists-action="delete" />
        <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
        <llm-emit-token-metric namespace="meternaut">
            <dimension name="Subscription ID" />
            <dimension name="API ID" />
            <dimension name="Model" value="@((string)context.Variables["requestedModel"])" />
        </llm-emit-token-metric>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
