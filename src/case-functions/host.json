{
  "version": "2.0",
  "functionTimeout": "00:45:00",
  "logging": {
    "logLevel": {
      "default": "Information",
      "Azure.Core": "Warning",
      "Azure.Identity": "Warning",
      "Microsoft.AspNetCore": "Warning"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": false
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "http": {
      "routePrefix": ""
    },
    "queues": {
      "batchSize": 1,
      "newBatchThreshold": 0,
      "maxDequeueCount": 5
    }
  }
}
